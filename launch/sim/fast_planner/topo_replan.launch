<launch>
  <!-- global parameters -->
  <arg name="map_size_x" value="50.0"/>
  <arg name="map_size_y" value="20.0"/>
  <arg name="map_size_z" value="3.00"/>

  <arg name="odom_topic" value="/mavros/local_position/odom" />

  <!-- main algorithm params -->
  <include file="$(find rsun_uas)/launch/sim/fast_planner/topo_algorithm.xml">
    <!-- size of map -->
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>

    <!-- sensor pose: transform of camera frame in the world frame -->
    <arg name="sensor_pose_topic" value="/camera/pose"/>
    <!-- depth topic: depth image, 640x480 by default -->
    <!-- cloud topic: point cloud measurement  -->
    <!-- subscribe ONLY TO ONE of the two topics -->
    <arg name="depth_topic" value="/phoenix_d456/camera/depth/image_raw"/>
    <arg name="cloud_topic" value="/pcl_render_node/cloud"/>

    <!-- intrinsic params of the depth camera -->
    <arg name="cx" value="320.50"/>
    <arg name="cy" value="240.50"/>
    <arg name="fx" value="337.2084410968044"/>
    <arg name="fy" value="337.2084410968044"/>

    <!-- maximum velocity and acceleration the drone will reach -->
    <arg name="max_vel" value="0.5" />
    <arg name="max_acc" value="0.5" />

    <!-- 1: use 2D Nav Goal to select goal  -->
    <!-- 2: use global waypoints below  -->
    <!-- 3: use global reference path passing points below  -->
    <arg name="flight_type" value="1" />

    <!-- global waypoints -->
    <arg name="point_num" value="0" />

    <arg name="point0_x" value="19.99" />
    <!-- <arg name="point0_x" value="2" /> -->
    <arg name="point0_y" value="0.0" />
    <arg name="point0_z" value="1.0" />

    <!-- set more waypoints if you need -->
    <arg name="point1_x" value="19.99" />
    <arg name="point1_y" value="0.0" />
    <arg name="point1_z" value="1.0" />

    <arg name="point2_x" value="-19.0" />
    <arg name="point2_y" value="0.0" />
    <arg name="point2_z" value="1.0" />
  </include>

  <!-- trajectory server -->
  <node pkg="plan_manage" name="fast_planner_traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="/fast_planner/planning/pos_cmd"/>
    <remap from="/planning/replan" to="/fast_planner/planning/replan"/>
    <remap from="/planning/new" to="/fast_planner/planning/new"/>
    <remap from="/planning/bspline" to="/fast_planner/planning/bspline"/>
    <remap from="/planning/position_cmd_vis" to="/fast_planner/planning/position_cmd_vis"/>
    <remap from="/planning/travel_traj" to="/fast_planner/planning/travel_traj"/>

    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <param name="traj_server/time_forward" value="1.5" type="double"/>
    <param name="traj_server/pub_traj_id" value="0" type="int"/>
  </node>

</launch>
